# Copy to .env.dev for the shared development environment.

# Public app URL. Keep http while the dev domain is not HTTPS-enabled.
SKYBLOOM_PUBLIC_BASE_URL=http://your-dev-domain
SKYBLOOM_PUBLIC_WS_BASE_URL=ws://your-dev-domain

# Browser-facing frontend settings.
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-me
NEXT_PUBLIC_SUPABASE_REDIRECT_URL=http://your-dev-domain/auth/callback
VITE_HMR_HOST=your-dev-domain
VITE_HMR_CLIENT_PORT=80
VITE_ALLOWED_HOSTS=your-dev-domain

# Supabase Storage S3-compatible credentials.
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_REGION=ap-southeast-2
AWS_S3_ENDPOINT_URL=https://project-ref.storage.supabase.co/storage/v1/s3

# Postgres document indexing.
POSTGRES_HOST=replace-me
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=replace-me
POSTGRES_PASSWORD=replace-me
POSTGRES_SSLMODE=require

# OpenAI settings for document sectioning and game generation.
OPENAI_API_KEY=replace-me
SECTIONING_LLM_MODEL=gpt-4o-mini
LEVEL_LLM_MODEL=gpt-4o-mini


# Document-content worker filesystem paths.
INPUT_ROOT=/temp
OUTPUT_ROOT=/output

# User service and auth cookie.
SUPABASE_JWT_SECRET=replace-me

# RunPod OCR endpoint used by the OCR coordinator.
RUNPOD_API_KEY=replace-me
RUNPOD_ENDPOINT_ID=replace-me
