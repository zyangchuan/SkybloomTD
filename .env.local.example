# Copy to .env.local for local Docker Compose runs.

# Public app URL used by docs and external auth providers.
SKYBLOOM_PUBLIC_BASE_URL=http://localhost
SKYBLOOM_PUBLIC_WS_BASE_URL=ws://localhost

# Local host ports.
GAME_CLIENT_PORT=5173
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
REDIS_PORT=6379

# Compose health checks.
NGINX_HEALTHCHECK_URL=http://127.0.0.1/nginx-health
DOCUMENT_CONTENT_GRPC_HEALTHCHECK_HOST=127.0.0.1
DOCUMENT_CONTENT_GRPC_HEALTHCHECK_PORT=50051

# Internal service URLs for the local compose network.
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
REDIS_URL=redis://redis:6379/0
GAME_STATUS_REDIS_URL=redis://redis:6379/0
GAME_MAP_REDIS_URL=redis://game-redis:6379/0
GAME_SESSION_REDIS_URL=redis://game-redis:6379/0
DOCUMENT_CONTENT_GRPC_ADDR=document-content-grpc:50051
VITE_API_PROXY_TARGET=http://reverse-proxy
VITE_HMR_PROTOCOL=ws
VITE_HMR_HOST=localhost
VITE_HMR_CLIENT_PORT=5173

# Queues.
DOCUMENT_CONTENT_QUEUE=document.process
GAME_GENERATION_QUEUE=game.generation.generate

# Supabase Storage S3-compatible credentials.
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_REGION=ap-southeast-2
AWS_S3_ENDPOINT_URL=https://project-ref.storage.supabase.co/storage/v1/s3
AWS_S3_BUCKET=documents
AWS_S3_PREFIX=dev

# Postgres / pgvector indexing.
POSTGRES_HOST=replace-me
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=replace-me
POSTGRES_PASSWORD=replace-me
POSTGRES_SSLMODE=require

# OpenAI and model settings.
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
ENABLE_EMBEDDINGS=false
EMBEDDING_MODEL=text-embedding-3-small
SECTIONING_LLM_MODEL=gpt-4o-mini
SECTIONING_LLM_TIMEOUT_SECONDS=120
SECTIONING_LLM_MAX_RETRIES=2
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
CHUNK_MAX_CHARS=6000
CHUNK_OVERLAP_LINES=4
LEVEL_LLM_MODEL=gpt-4o-mini
LEVEL_LLM_TEMPERATURE=0.2
LEVEL_LLM_TIMEOUT_SECONDS=60
LEVEL_LLM_MAX_RETRIES=3
LEVEL_SOURCE_MAX_CHARS=24000

# User service and auth cookie.
USER_SERVICE_PORT=8080
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_JWT_SECRET=replace-me
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=
ALLOW_UNVERIFIED_JWT=false
AUTH_ACCESS_TOKEN_COOKIE=skybloom_access_token
AUTH_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=*
