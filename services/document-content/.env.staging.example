# Copy to .env.staging for document-content API, worker, and gRPC services.

# S3-compatible storage. Source PDFs and OCR markdown share this bucket.
# Object paths are derived as:
#   {user_id}/{document_id}/source/{source_filename}
#   {user_id}/{document_id}/output.md
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_REGION=ap-southeast-2
AWS_S3_ENDPOINT_URL=https://project-ref.storage.supabase.co/storage/v1/s3

# Postgres database used by the API, worker indexing, and gRPC service.
POSTGRES_HOST=replace-me
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=replace-me
POSTGRES_PASSWORD=replace-me
POSTGRES_SSLMODE=require

# OpenAI settings for LLM-based document sectioning.
OPENAI_API_KEY=replace-me
SECTIONING_LLM_MODEL=gpt-4o-mini


# RunPod OCR endpoint used by the OCR coordinator.
RUNPOD_API_KEY=replace-me
RUNPOD_ENDPOINT_ID=replace-me
