# Copy to .env.production for the document-content worker.

# RabbitMQ message queue for document processing jobs.
RABBITMQ_URL=amqp://user:password@rabbitmq-host:5672/
DOCUMENT_CONTENT_QUEUE=document.process

# Redis task-status server shared with the document-content API.
REDIS_URL=redis://:password@redis-host:6379/0
TASK_STATUS_TTL_SECONDS=604800

# Supabase Storage / S3-compatible source and OCR output storage.
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_REGION=ap-southeast-2
AWS_S3_ENDPOINT_URL=https://project-ref.storage.supabase.co/storage/v1/s3
AWS_S3_BUCKET=documents
AWS_S3_PREFIX=prod

# Postgres target for document indexing.
POSTGRES_HOST=replace-me
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=replace-me
POSTGRES_PASSWORD=replace-me
POSTGRES_SSLMODE=require

# OpenAI settings for LLM-based document sectioning.
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
SECTIONING_LLM_MODEL=gpt-4o-mini
SECTIONING_LLM_TIMEOUT_SECONDS=120
SECTIONING_LLM_MAX_RETRIES=2
SECTIONING_OUTLINE_MAX_REPAIRS=2

# Worker filesystem paths. These should match the worker container mounts.
INPUT_ROOT=/temp
