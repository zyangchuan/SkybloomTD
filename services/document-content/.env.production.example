# Copy to .env.production for document-content API, worker, and gRPC services.

# API runtime.
GIN_MODE=release

# RabbitMQ message queue for document processing jobs.
RABBITMQ_URL=amqp://user:password@rabbitmq-host:5672/
RABBITMQ_HEARTBEAT_SECONDS=600

# Redis task-status server shared by the API and worker.
REDIS_URL=redis://:password@redis-host:6379/0
TASK_STATUS_TTL_SECONDS=604800

# S3-compatible storage. Source PDFs and OCR markdown share this bucket.
# Object paths are derived as:
#   {user_id}/{document_id}/source/{source_filename}
#   {user_id}/{document_id}/output.md
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_REGION=ap-southeast-2
AWS_S3_ENDPOINT_URL=https://project-ref.storage.supabase.co/storage/v1/s3
AWS_S3_BUCKET=documents

# Postgres database used by the API, worker indexing, and gRPC service.
POSTGRES_HOST=replace-me
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=replace-me
POSTGRES_PASSWORD=replace-me
POSTGRES_SSLMODE=require

# OpenAI settings for LLM-based document sectioning.
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
SECTIONING_LLM_MODEL=gpt-4o-mini

# Worker filesystem paths. These should match the worker container mounts.
INPUT_ROOT=/temp
OUTPUT_ROOT=/output
